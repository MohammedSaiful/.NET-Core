@model IEnumerable<Order>

<h2>My Orders</h2>

<table class="table">

    <tr>
        <th>Id</th>
        <th>Date</th>
        <th>Total</th>
        <th>Status</th>
        <th></th>
    </tr>

    @foreach (var order in Model)
    {
        <tr>
            <td>@order.Id</td>
            <td>@order.OrderDate</td>
            <td>@order.TotalAmount</td>
            <td>@order.Status</td>

            <td>
                <a asp-action="Details" asp-route-id="@order.Id">
                    Details
                </a>
            </td>
        </tr>
    }

</table>